# Nova configuration — copy to .env and fill in your key(s).

# Which vendor backs the agent: "openai" or "anthropic".
NOVA_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Any chat model your key can access (e.g. gpt-4o, gpt-4o-mini, gpt-4.1).
OPENAI_MODEL=gpt-4o

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...
# e.g. claude-opus-4-8 (most capable), claude-sonnet-4-6, claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-8

# Max tokens per response.
NOVA_MAX_TOKENS=1024

# Where Nova's SQLite state/memory store lives. Default: ~/.nova/nova.db
# (a user-level dir outside any project). Set an absolute or relative path to override.
NOVA_DB_PATH=~/.nova/nova.db
